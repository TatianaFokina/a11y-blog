<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="{{ description or "site description" | translate | safe }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

{% set isHomePage = page.url === ("/" + page.lang + "/") %}
<title>
	{% if isHomePage %}
		{{ "site name" | translate | safe }}
	{% else %}
		{{ title }} — {{ "site name" | translate | safe }}
	{% endif %}
</title>

{% for link in page.url | locale_links | hreflangLinks(page.url, page.lang) %}
	<link rel="alternate" hreflang="{{ link.lang }}" href="{{ site.url }}{{ link.url }}">
{% endfor %}
